{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "types": ["$app/types", "node", "vite/client"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["src/service-worker"]
}
